{
  "comments": { "lineComment": "%" },
  "brackets": [],
  "autoClosingPairs": [
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "“", "close": "”", "notIn": ["string", "comment"] },
    { "open": "「", "close": "」", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [["\"", "\""], ["“", "”"], ["「", "」"]],
  "wordPattern": "-?[0-9]+/[0-9]+|-?[0-9]+(?:st|nd|rd|th)?|第[一二三四五六七八九]行|[右中左]行|[A-Za-z]+|[^\\s\\x00-\\x7F，、。“”「」·]+"
}
