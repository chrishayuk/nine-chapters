{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Nine Chapters (jiuzhang)",
  "scopeName": "source.jz",
  "fileTypes": ["jz"],
  "patterns": [
    { "include": "#note" },
    { "include": "#heading" },
    { "include": "#line" }
  ],
  "repository": {
    "note": {
      "comment": "% to the end of the line: a note. At the start of a line, or after a space.",
      "name": "comment.line.percentage.jiuzhang",
      "match": "(?:^|(?<=\\s))%.*$"
    },
    "heading": {
      "comment": "No. 8.1, No. 8.18 (Liu Hui: …): a heading, the whole line.",
      "match": "^\\s*(No\\..*?)\\s*$",
      "captures": { "1": { "name": "entity.name.section.problem.jiuzhang" } }
    },
    "line": {
      "patterns": [
        { "include": "#note" },
        { "include": "#words" },
        { "include": "#operation" },
        { "include": "#not-an-operation" },
        { "include": "#how" },
        { "include": "#method" },
        { "include": "#joining" },
        { "include": "#column" },
        { "include": "#figure" },
        { "include": "#bar" },
        { "include": "#comma" },
        { "include": "#stop" },
        { "include": "#thing" }
      ]
    },
    "words": {
      "comment": "The source's words: a line of its own, or at the end of an operation. Not computed.",
      "patterns": [
        {
          "name": "string.quoted.double.jiuzhang",
          "begin": "\"",
          "end": "\"|$",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.jiuzhang" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.jiuzhang" } }
        },
        {
          "name": "string.quoted.double.jiuzhang",
          "begin": "“",
          "end": "”|$",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.jiuzhang" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.jiuzhang" } }
        },
        {
          "name": "string.quoted.other.corner.jiuzhang",
          "begin": "「",
          "end": "」|$",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.jiuzhang" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.jiuzhang" } }
        }
      ]
    },
    "operation": {
      "comment": "The word an operation starts with: at the start of the line, or of a reading after |.",
      "match": "(?:^|(?<=\\|))\\s*\\b(Things|Set|Multiply|Take|Add|Halve|Reduce|Divide|Drop|Gives|Solve|Answer|Rates|Count|Nothing)\\b",
      "captures": { "1": { "name": "keyword.control.operation.jiuzhang" } }
    },
    "not-an-operation": {
      "comment": "Any other word where an operation should start.",
      "match": "(?:^|(?<=\\|))\\s*([^\\s\"“「%|]+)",
      "captures": { "1": { "name": "invalid.illegal.jiuzhang" } }
    },
    "how": {
      "comment": "How a column is taken from another: 直除, 不足減乃止, 相減, 互乘.",
      "name": "keyword.other.how.jiuzhang",
      "match": "\\buntil\\s+the\\s+head\\s+is\\s+gone\\b|\\bas\\s+far\\s+as\\s+it\\s+goes\\b|\\bin\\s+turn\\b|\\bcrosswise\\b"
    },
    "method": {
      "comment": "Solve by text, reducing, cross or one: the readings of the procedure.",
      "match": "\\b(by)\\s+(text|reducing|cross|one)\\b",
      "captures": {
        "1": { "name": "keyword.other.jiuzhang" },
        "2": { "name": "support.constant.method.jiuzhang" }
      }
    },
    "joining": {
      "comment": "The words that join an operation's parts.",
      "name": "keyword.other.jiuzhang",
      "match": "\\b(?:by|from|to|of|the|head|at|until|is|gone|as|far|it|goes|in|turn)\\b"
    },
    "column": {
      "comment": "A column (行), counted from the right: right, middle, left, 2nd, 3rd …; 右行, 中行, 左行, 第二行 … 第九行.",
      "name": "entity.name.type.column.jiuzhang",
      "match": "\\b(?:right|middle|left|[0-9]+(?:st|nd|rd|th))\\b|[右中左]行|第[一二三四五六七八九]行"
    },
    "figure": {
      "patterns": [
        {
          "comment": "A whole number and a fraction, or a fraction: 9 1/4, 1 18/52, 1/2.",
          "name": "constant.numeric.fraction.jiuzhang",
          "match": "(?<![\\w/])[-−+]?(?:[0-9]+[ \\t]+)?[0-9]+/[0-9]+(?![\\w/])"
        },
        {
          "comment": "A whole number, positive (正) or negative (負).",
          "name": "constant.numeric.whole.jiuzhang",
          "match": "(?<![\\w/])[-−+]?[0-9]+(?![\\w/])"
        },
        {
          "comment": "An empty position.",
          "name": "constant.numeric.empty.jiuzhang",
          "match": "·"
        }
      ]
    },
    "bar": {
      "comment": "Readings in the alternative.",
      "name": "keyword.operator.reading.jiuzhang",
      "match": "\\|"
    },
    "comma": {
      "name": "punctuation.separator.comma.jiuzhang",
      "match": "[,，]"
    },
    "stop": {
      "comment": "A full stop ends an operation and means nothing.",
      "name": "punctuation.terminator.statement.jiuzhang",
      "match": "[.。]"
    },
    "thing": {
      "comment": "Anything else in an operation: the name of a thing, a position of the column (上禾, 實).",
      "name": "variable.other.thing.jiuzhang",
      "match": "[^\\s\"“「%|,，.。·]+"
    }
  }
}
